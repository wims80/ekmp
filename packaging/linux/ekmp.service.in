# EVE Killmail Publisher refresh service, run as a systemd user service.
# It refreshes cached data only and never posts killmails.
#
# This is a template: packaging replaces @BINDIR@ with the directory holding
# the ekmp executable (~/.local/bin for install.sh, /usr/bin for the PKGBUILD).
#
# Enable:   systemctl --user enable --now ekmp.service
# Logs:     journalctl --user -u ekmp
# To keep it running while you are logged out: loginctl enable-linger "$USER"

[Unit]
Description=EVE Killmail Publisher refresh service (never posts killmails)
Documentation=https://github.com/wims80/ekmp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@BINDIR@/ekmp service run
Restart=on-failure
RestartSec=60
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
